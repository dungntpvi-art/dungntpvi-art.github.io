rules_version = '2';
// Luật bảo mật cho Sa Bàn Chiến Thuật.
// Dán toàn bộ file này vào Firebase Console → Firestore Database → Rules → Publish.
//
// Vai trò (lưu ở users/{uid}.role):
//   admin     – toàn quyền, quản lý tài khoản
//   coach     – HLV: tạo, sửa bài, giáo án, danh sách đội; duyệt người mới, cấp Trợ lý / Cầu thủ
//   assistant – Trợ lý: như HLV, không quản lý tài khoản
//   viewer    – Cầu thủ / phụ huynh: chỉ xem
//   pending   – vừa tự đăng ký, chờ Admin duyệt (không xem được dữ liệu đội)
//   disabled  – đã khoá
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function role() { return signedIn() && exists(userDoc()) ? get(userDoc()).data.role : 'none'; }
    function isAdmin() { return role() == 'admin'; }
    function canEdit() { return role() in ['admin', 'coach', 'assistant']; }
    function member() { return role() in ['admin', 'coach', 'assistant', 'viewer']; }
    function adminPath() { return /databases/$(database)/documents/meta/admin; }
    function teamPath(tid) { return /databases/$(database)/documents/teams/$(tid); }
    // Thuộc đội: Admin thuộc mọi đội; người khác phải có tên trong danh sách thành viên của đội
    function inTeam(tid) { return isAdmin() || (member() && exists(teamPath(tid)) && request.auth.uid in get(teamPath(tid)).data.members); }

    // Người đầu tiên bấm "Nhận quyền Admin" trở thành Admin. Sau đó không ai tạo lại được.
    match /meta/admin {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(adminPath()) && request.resource.data.uid == request.auth.uid;
    }

    // Đánh dấu đã chuyển dữ liệu cũ sang đội đầu tiên (chỉ tạo một lần)
    match /meta/migrated {
      allow read: if signedIn();
      allow create: if canEdit();
    }

    match /users/{uid} {
      // Chỉ chủ tài khoản và Admin đọc được. HLV / Trợ lý xem thành viên qua danh bạ đội (teams/{tid}/people)
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Tự đăng ký: chỉ được tạo hồ sơ của mình với vai trò "pending". Admin tạo được cho người khác.
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'pending');
      // Tự sửa hồ sơ (tên…) nhưng không tự đổi vai trò; riêng lúc nhận quyền Admin lần đầu.
      // HLV phân quyền cho người khác: chỉ đổi vai trò giữa Chờ duyệt / Trợ lý / Cầu thủ / Khoá, không đụng tới HLV và Admin.
      // Chỉ với người trong đội của HLV hoặc người đã gửi yêu cầu vào đội đó (roleTeam = mã đội)
      allow update: if isAdmin()
        || (role() == 'coach' && request.auth.uid != uid
            && resource.data.role in ['pending', 'assistant', 'viewer', 'disabled']
            && request.resource.data.role in ['assistant', 'viewer', 'disabled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'roleTeam'])
            && request.resource.data.roleTeam is string
            && inTeam(request.resource.data.roleTeam)
            && (uid in get(teamPath(request.resource.data.roleTeam)).data.members
                || exists(/databases/$(database)/documents/teams/$(request.resource.data.roleTeam)/requests/$(uid))))
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role)
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'admin'
            && getAfter(adminPath()).data.uid == request.auth.uid);
      allow delete: if isAdmin();

      // Kho riêng: chỉ chủ tài khoản đọc / ghi
      match /private/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Mã mời vào đội: ai đăng nhập cũng tra được một mã (không liệt kê được danh sách mã)
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if canEdit() && request.resource.data.tid is string && inTeam(request.resource.data.tid)
        && request.resource.data.by == request.auth.uid;
      allow delete: if canEdit() && inTeam(resource.data.tid);
    }

    // Nhiều đội: mỗi đội có thành viên riêng, bài, giáo án và dữ liệu (danh sách, điểm danh, trận, sao)
    match /teams/{tid} {
      allow read: if isAdmin() || (member() && request.auth.uid in resource.data.members);
      allow create: if canEdit() && request.auth.uid in request.resource.data.members;
      allow update: if canEdit() && inTeam(tid) && request.resource.data.members is list;
      allow delete: if isAdmin();

      // Progress notes are deliberately outside /data: parents may read only
      // records assigned to their authenticated UID by an editor of this team.
      match /development/{kid} {
        allow read: if inTeam(tid) && (canEdit()
          || request.auth.uid in resource.data.guardianUids);
        allow create, update: if canEdit() && inTeam(tid)
          && request.resource.data.keys().hasOnly(['kid', 'name', 'guardianUids', 'entries', 'updatedBy', 'updatedAt'])
          && request.resource.data.kid is string
          && request.resource.data.name is string
          && request.resource.data.guardianUids is list
          && request.resource.data.guardianUids.size() <= 10
          && request.resource.data.guardianUids.hasOnly(get(teamPath(tid)).data.members)
          && request.resource.data.entries is list
          && request.resource.data.entries.size() <= 200
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if canEdit() && inTeam(tid);
      }
      // Skill / position assessments never become visible to parents.
      match /scouting/{kid} {
        allow read: if canEdit() && inTeam(tid);
        allow create, update: if canEdit() && inTeam(tid)
          && request.resource.data.keys().hasOnly(['kid', 'skill', 'position'])
          && request.resource.data.kid is string
          && request.resource.data.skill is int
          && request.resource.data.skill >= 1 && request.resource.data.skill <= 5
          && request.resource.data.position in ['gk', 'defend', 'middle', 'attack'];
        allow delete: if canEdit() && inTeam(tid);
      }

      match /boards/{id} {
        allow read: if inTeam(tid) || resource.data.public == true;
        allow create, update, delete: if canEdit() && inTeam(tid);
      }
      match /plans/{id} {
        allow read: if inTeam(tid);
        allow create, update, delete: if canEdit() && inTeam(tid);
      }
      match /data/{doc} {
        allow read: if inTeam(tid);
        allow write: if canEdit() && inTeam(tid);
      }
      // Danh bạ thành viên đội: HLV / Trợ lý của đội xem; mỗi người tự ghi mục của mình (đúng vai trò thật)
      match /people/{pid} {
        allow read, write: if canEdit() && inTeam(tid);
        allow create, update: if signedIn() && request.auth.uid == pid && inTeam(tid)
          && request.resource.data.role == role();
      }
      // Xin vào đội bằng mã mời: người xin tự tạo yêu cầu của mình; HLV / Admin của đội xem và duyệt
      match /requests/{rid} {
        allow get: if signedIn() && request.auth.uid == rid;
        allow read: if canEdit() && inTeam(tid);
        allow create, update: if signedIn() && request.auth.uid == rid && request.resource.data.code is string
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.code))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.tid == tid;
        allow delete: if (canEdit() && inTeam(tid)) || (signedIn() && request.auth.uid == rid);
      }
      // Phụ huynh báo con nghỉ buổi tập: ai trong đội cũng tạo được báo nghỉ của chính mình; HLV/Trợ lý xoá được
      match /absence/{id} {
        allow read: if inTeam(tid);
        allow create: if inTeam(tid) && request.resource.data.uid == request.auth.uid
          && request.resource.data.kid is string && request.resource.data.date is string;
        allow delete: if inTeam(tid) && (resource.data.uid == request.auth.uid || canEdit());
      }
    }

    // ---- Dữ liệu cũ (trước khi có nhiều đội); app tự chép sang đội đầu tiên ----

    // Bài chiến thuật / bài tập của đội. public == true: ai có link cũng xem được (chỉ xem).
    match /boards/{id} {
      allow read: if member() || resource.data.public == true;
      allow create, update, delete: if canEdit();
    }

    match /plans/{id} {
      allow read: if member();
      allow create, update, delete: if canEdit();
    }

    match /team/{doc} {
      allow read: if member();
      allow write: if canEdit();
    }
  }
}
